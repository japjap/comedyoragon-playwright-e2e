# Copy to .env (git-ignored) and adjust.

# Site under test. Defaults to http://localhost:3000 when unset.
# Never point the local suite at production (https://comedyoragon.com); production
# is only reached by the read-only projects (npm run test:smoke / test:prod-content).
BASE_URL=http://localhost:3000

# LOCAL comedyoragon Docker Postgres, used by helpers/db.ts to seed shows (SHW-01/02)
# and verify booking side effects. The helper refuses any host other than
# localhost or 127.0.0.1. Use the same value as DATABASE_URL in ../comedyoragon/.env.
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/comedyoragon_dev
